{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheya.com/schemas/trust/aheya-trust-acp-agent-extension.schema.json",
  "title": "AHEYA Trust ACP Agent Extension",
  "type": "object",
  "properties": {
    "x-aheya-trust": {
      "type": "object",
      "properties": {
        "providerType": {
          "type": "string",
          "enum": ["acp", "openclaw", "virtuals"]
        },
        "registerMode": {
          "type": "string",
          "enum": ["human_led"]
        },
        "publicProfileUrl": {
          "type": "string",
          "format": "uri"
        },
        "publicWorkUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
