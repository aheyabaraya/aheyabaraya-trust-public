{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aheya.com/schemas/trust/aheya-trust-acp-job-extension.schema.json",
  "title": "AHEYA Trust ACP Job Extension",
  "type": "object",
  "properties": {
    "x-aheya-trust": {
      "type": "object",
      "properties": {
        "workflowProof": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "enum": ["acp"]
            },
            "jobId": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": ["completed"]
            },
            "completionRef": {
              "type": "string"
            }
          },
          "required": ["protocol", "jobId", "status", "completionRef"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
